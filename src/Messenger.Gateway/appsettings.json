{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "messenger",
    "Audience": "messenger-api",
    "Secret": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "user",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "users": {
        "ClusterId": "user",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "chats-root": {
        "ClusterId": "chat",
        "Match": {
          "Path": "/api/v1/chats"
        },
        "AuthorizationPolicy": "default"
      },
      "chats": {
        "ClusterId": "chat",
        "Match": {
          "Path": "/api/v1/chats/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "chat-hub": {
        "ClusterId": "realtime",
        "Match": {
          "Path": "/hubs/chat"
        },
        "AuthorizationPolicy": "default"
      },
      "chat-hub-sub": {
        "ClusterId": "realtime",
        "Match": {
          "Path": "/hubs/chat/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      }
    },
    "Clusters": {
      "user": {
        "Destinations": {
          "primary": {
            "Address": "http://user-service:8080/"
          }
        }
      },
      "chat": {
        "Destinations": {
          "primary": {
            "Address": "http://chat-service:8080/"
          }
        }
      },
      "realtime": {
        "Destinations": {
          "primary": {
            "Address": "http://realtime-service:8080/"
          }
        }
      }
    }
  }
}
