# Только для локальной разработки. Скопируй в .env и при необходимости поменяй значения.
GATEWAY_PORT=5000
USER_SERVICE_PORT=5001
CHAT_SERVICE_PORT=5002
REALTIME_SERVICE_PORT=5003

# Порты на хосте. Меняем, если 5432/5672/15672 уже заняты.
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-dev
USER_DB_PASSWORD=change-me-user-service-dev
CHAT_DB_PASSWORD=change-me-chat-service-dev

RABBITMQ_DEFAULT_USER=messenger
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-dev

JWT_SECRET=dev-only-please-change-me-32-characters-minimum
JWT_ISSUER=messenger
JWT_AUDIENCE=messenger-api
